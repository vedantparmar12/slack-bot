# OpenAI
OPENAI_API_KEY=sk-...

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=support_docs
QDRANT_CACHE_COLLECTION=query_cache

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support_rag

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
SLACK_SUPPORT_CHANNELS=C01234567,C09876543

# Confluence
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=...
CONFLUENCE_SPACES=SUPPORT,DEVPORTAL

# Git Docs
GIT_DOC_REPOS=https://github.com/org/dev-portal.git,https://github.com/org/docs.git
GIT_DOC_BRANCH=main
GIT_CLONE_DIR=./data/repos

# Embedding
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=100

# LLM
LLM_MODEL=gpt-4o
LLM_EXPANSION_MODEL=gpt-4o-mini

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_TOP_K=5

# Cache
CACHE_EXACT_TTL_SECONDS=3600
CACHE_SEMANTIC_TTL_SECONDS=14400
CACHE_SEMANTIC_THRESHOLD=0.95

# Search
SEARCH_TOP_K=50
SEARCH_RERANK_TOP_K=20
SEARCH_FINAL_TOP_K=5

# Feedback
FEEDBACK_MIN_VOTES=3
FEEDBACK_DECAY_RATE=0.05

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
